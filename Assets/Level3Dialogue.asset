  m_Script: {fileID: 11500000, guid: 84b5d11043e104c5bba24c514e54451f, type: 3}
  m_Name: Level3Dialogue
  m_EditorClassIdentifier: 
  lines:
  - text: EarthCommand, this is Astro1. Do you read me, over. I've started calling
      this planet MoonShroom.
  - text: My surface scanner is getting interference. It's showing only cliffs and
      rocky terrain.
  - text: I heard some static on Astro2's channel. I must be getting closer.
