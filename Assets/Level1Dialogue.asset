  m_Script: {fileID: 11500000, guid: 84b5d11043e104c5bba24c514e54451f, type: 3}
  m_Name: Level1Dialogue
  m_EditorClassIdentifier: 
  lines:
  - text: EarthCommand, this is Astro1. We've landed on Kepler-452b. I've lost contact
      with Astro2. Do you read me, over.
  - text: 'Mission Log: Communication not established. Life forms confirmed. They
      are fungal-like and potentially hostile. Those hit with debris from above perished. '
  - text: I must go search for Astro2.
