  m_Script: {fileID: 11500000, guid: 84b5d11043e104c5bba24c514e54451f, type: 3}
  m_Name: Level2Dialogue
  m_EditorClassIdentifier: 
  lines:
  - text: EarthCommand, this is Astro1. Contact still not reestablished with Astro2.
      Do you read me, over.
  - text: 'A new specimen has been identified. It produces clouds of poisonous spores
      that kill anything they touch. '
  - text: I was able to fix my laser gun that got damaged on impact. This will come
      in handy against the hostiles. Press "F" to shoot.
